<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      This manifest is merged ONLY into Debug builds.
      It enables cleartext HTTP traffic specifically so you can test locally against your laptop's LAN IP (http://192.168.x.x).
      Release builds will still strictly enforce HTTPS.
    -->
    <application android:usesCleartextTraffic="true" />
</manifest>
